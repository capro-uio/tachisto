{
  "name": "@tachisto/cli",
  "version": "0.0.2",
  "description": "Validate and compile Tachisto experiment specs from the command line.",
  "keywords": [
    "jsPsych",
    "psychology",
    "behavioural experiments",
    "cli",
    "no-code"
  ],
  "homepage": "https://www.capro.dev/tachisto/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/capro-uio/tachisto.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/capro-uio/tachisto/issues"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "main": "dist/src/index.js",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "bin": {
    "tachisto": "dist/src/main.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@tachisto/compiler": "^0.0.2",
    "@tachisto/schemas": "^0.0.2"
  },
  "types": "dist/src/index.d.ts"
}
