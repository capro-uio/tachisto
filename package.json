{
  "name": "tachisto",
  "private": true,
  "description": "A no-code builder for jsPsych experiments: author in the browser, export readable jsPsych you can host anywhere.",
  "keywords": [
    "jsPsych",
    "psychology",
    "behavioural experiments",
    "online experiments",
    "no-code"
  ],
  "homepage": "https://www.capro.dev/tachisto/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/capro-uio/tachisto.git"
  },
  "bugs": {
    "url": "https://github.com/capro-uio/tachisto/issues"
  },
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "pretest": "npm run build:packages",
    "test": "npm run test --workspaces --if-present",
    "precoverage": "npm run build:packages",
    "coverage": "npm run test --workspaces --if-present -- --coverage",
    "schemas": "npm run extract --workspace @tachisto/schemas",
    "spec-schema": "npm run spec-schema --workspace @tachisto/compiler",
    "codemeta": "npm run codemeta --workspace @tachisto/compiler",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prelint": "npm run build:packages",
    "lint": "eslint .",
    "pretypecheck": "npm run build:packages",
    "typecheck": "tsc -p packages/schemas/tsconfig.json && tsc -p packages/compiler/tsconfig.json && tsc -p packages/cli/tsconfig.json && tsc -p packages/mcp/tsconfig.json && npm run check --workspace @tachisto/builder && tsc -p apps/site/tsconfig.json",
    "predev": "npm run build:packages",
    "dev": "npm run dev --workspace @tachisto/builder",
    "predev:site": "npm run build:packages",
    "dev:site": "npm run dev --workspace @tachisto/site",
    "prebuild:pages": "npm run build:packages",
    "build:pages": "npm run build --workspace @tachisto/site && npm run build --workspace @tachisto/builder && node apps/site/scripts/pages.ts",
    "build:packages": "npm run build --workspace @tachisto/schemas && npm run build --workspace @tachisto/compiler && npm run build --workspace @tachisto/cli"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "overrides": {
    "vite": "$vite",
    "@grpc/grpc-js": "^1.13.6",
    "@tensorflow/tfjs": {
      "argparse": "^2.0.1"
    }
  }
}
